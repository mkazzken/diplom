{
    "data_dir": "dataset",
    "max_sims_per_type": 400,
    "features": [
        8,
        16,
        32,
        64
    ],
    "dropout": 0.05,
    "use_T_t": true,
    "use_T_prev": true,
    "use_delta_T": true,
    "batch_size": 16,
    "epochs": 50,
    "learning_rate": 0.0001,
    "weight_decay": 1e-05,
    "early_stopping_patience": 10,
    "train_ratio": 0.7,
    "val_ratio": 0.15,
    "test_ratio": 0.15,
    "seed": 42,
    "regularization_weights": {
        "data": 1.0,
        "temperature_hint": 0.01,
        "spatial_smooth": 0.005,
        "temporal_hint": 0.005,
        "enthalpy_hint": 0.005
    },
    "T_m": 327.5,
    "T_initial": 25.0,
    "device": "cuda",
    "num_workers": 0,
    "task_type": "same_time"
}