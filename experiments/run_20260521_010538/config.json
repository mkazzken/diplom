{
    "data_dir": "dataset",
    "max_sims_per_type": 400,
    "features": [
        32,
        64,
        128,
        256
    ],
    "dropout": 0.1,
    "use_T_t": true,
    "use_T_prev": true,
    "use_delta_T": true,
    "batch_size": 16,
    "epochs": 80,
    "learning_rate": 0.0001,
    "weight_decay": 1e-05,
    "early_stopping_patience": 15,
    "train_ratio": 0.7,
    "val_ratio": 0.15,
    "test_ratio": 0.15,
    "seed": 42,
    "loss_mse_weight": 0.5,
    "loss_l1_weight": 0.3,
    "loss_gradient_weight": 0.2,
    "device": "cuda",
    "num_workers": 4,
    "task_type": "same_time"
}